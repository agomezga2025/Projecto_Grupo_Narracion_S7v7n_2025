// room script file

function room_Load()
{
SetBackgroundFrame(0);
gPerchero.Visible = true;
}

function room_Unload()
{
gPerchero.Visible = false;
}

function hCajon_Look(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Quizás este es el cajón del que me hablaron mis compañeros.");
}

function hCajon_Interact(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Parece estar cerrado, que raro, quizás se cerró por error.");
}

function hCajon_UseInv(Hotspot *theHotspot, CursorMode mode)
{
if (player.ActiveInventory == iLlave){
  // SetBackgroundFrame(1) cambiar a cajon abierto una vez metamos el sprite
  oGuantes.Visible = true;
  hCajon.Enabled = false;
  player.LoseInventory(iLlave);
  }
}

function oGuantes_AnyClick(Object *theObject, CursorMode mode)
{
cMills.Say("Guantes quirúrgicos, podrían servir.");
player.AddInventory(iGuantes);
oGuantes.Visible = false;
}
