// room script file

function on_call()
{
 int trans = (gulaSintonizacion1 + gulaSintonizacion2) * 5;
 
 if (trans > 100) { trans = 100; }
 if (trans < 0) { trans = 0; }
 
 if (trans == 100) { 
 oTVBlock.Visible = false; 
 gulaPuzzleTV = 1;
 }
 else { oTVBlock.Visible = true; }
 
 oStatic.Transparency = trans;
}

function room_Load()
{
gTV.Visible = true;
gInv.Visible = false;
}

function room_Unload()
{
gTV.Visible = false;
gInv.Visible = true;
}
