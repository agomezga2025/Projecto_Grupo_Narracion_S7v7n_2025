// room script file

function oVictima_Look(Object *theObject, CursorMode mode)
{
cMills.Say("La víctima, aparentemente un suicidio.");
}

function oVictima_Interact(Object *theObject, CursorMode mode)
{
cMills.Say("Si lo toco, contaminaré la posible evidencia.");
cMills.Say("Creo que mis compañeros hablaron algo de unos guantes en un cajón.");
}

function oVictima_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("No voy a hablar con el cadáver, no tiene sentido.");
}

function oEscritorio_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("No voy a hablar con un trozo de madera, no estoy tan chalado todavía… ¿o sí?");
}

function oEscritorio_Look(Object *theObject, CursorMode mode)
{
cMills.Say("Un escritorio de madera de roble, parece resistente.");
}

function oEscritorio_Interact(Object *theObject, CursorMode mode)
{
player.ChangeRoom(5, 999, 999);
}

function oPerchero_AnyClick(Object *theObject, CursorMode mode)
{
player.ChangeRoom(6, 999, 999);
}

function oVictima_UseInv(Object *theObject, CursorMode mode)
{
if (player.ActiveInventory == iGuantes) {
  player.ChangeRoom(7, 999, 999);
  }
}

function oCajaFuerte_Look(Object *theObject, CursorMode mode)
{
cMills.Say("Una caja fuerte… quizás encuentre algo importante dentro.");
}

function oCajaFuerte_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("¿Enserio? ¿Hablar con una caja fuerte?");
}

function oCajaFuerte_Interact(Object *theObject, CursorMode mode)
{
player.ChangeRoom(8, 999, 999);
}
