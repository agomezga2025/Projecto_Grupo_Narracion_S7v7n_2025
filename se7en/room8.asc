// room script file

function hTeclaA_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
avariciaTeclado = 0;
}

function hTeclaN_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
avariciaTeclado = 0;
}

function hTeclaG_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (avariciaTeclado == 0) { avariciaTeclado = 1; } 
else { avariciaTeclado = 0; }
}

function hTeclaL_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
avariciaTeclado = 0;
}

function hTeclaR_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (avariciaTeclado == 1) { avariciaTeclado = 2; } 
else { avariciaTeclado = 0; }
}

function hTeclaS_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
avariciaTeclado = 0;
}

function hTeclaD_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (avariciaTeclado == 4) {
  hTeclaD.Enabled = false;
  // Activar codigo una vez tengamos un sprite de la caja fuerte abierta SetBackgroundFrame(1)
  hObjetosValor.Enabled = true;
  if (avariciaTieneCuchillo == 0) {oCuchillo.Visible = true;}
  } 
else { avariciaTeclado = 0; }
}

function hTeclaE_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
if (avariciaTeclado == 2) { avariciaTeclado = 3; } 
else if (avariciaTeclado == 3) { avariciaTeclado = 4; }
else { avariciaTeclado = 0; }
}

function room_Load()
{
SetBackgroundFrame(0);
gPerchero.Visible = true;
hObjetosValor.Enabled = false;
oCuchillo.Visible = false;
}

function room_Unload()
{
gPerchero.Visible = false;
}

function hObjetosValor_Look(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("“Greed”, que en inglés significa avaricia.");
cMills.Say("Ahora voy entendiendo un poco más por qué tiene marcado esas letras en el cuerpo.");
}

function hObjetosValor_Talk(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("No, no estoy tan pirado como para ponerme a hablar con el dinero.");
}

function hObjetosValor_Interact(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Dinero, dinero, dinero. No debería llevarme nada de aquí por mucho que me lo pida el cuerpo.");
}

function oCuchillo_Look(Object *theObject, CursorMode mode)
{
cMills.Say("¿Un cuchillo lleno de sangre dentro de una caja fuerte?");
cMills.Say("Siendo claro, es raro… tiene pinta de ser el arma que se utilizó en el crimen.");
}

function oCuchillo_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("En fin… creo que no es un buen momento para ponerse a hablar con cuchillos.");
}

function oCuchillo_Interact(Object *theObject, CursorMode mode)
{
cMills.Say("Mejor utilizar la bolsa de evidencias que me ha dado mi compañero para guardar esto.");
}

function oCuchillo_UseInv(Object *theObject, CursorMode mode)
{
if (player.ActiveInventory == iBolsa) {
  oCuchillo.Visible = false;
  avariciaTieneCuchillo = 1;
  cMills.Say("Esta prueba debo entregársela al agente.");
  }
}
