// room script file

function oLata_Look(Object *theObject, CursorMode mode)
{
cMills.Say("Este tío tenía mucha habmbre por lo que veo.");
cWilliam.Say("¿Has averiguado eso tu solito?");
}

function oLata_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("Hasta donde yo se, las latas de metal no podían hablar.");
}

function oLata_Interact(Object *theObject, CursorMode mode)
{
cMills.Say("Están todas vacías menos esta.");
cMills.Say("¿Habrá algo importante dentro o solo más comida?");
player.AddInventory(iLataCerrada);
oLata.Visible = false;
}

function oAbrelatas_Look(Object *theObject, CursorMode mode)
{
cMills.Say("¿Se ha caído esto de la mesa?");
}

function oAbrelatas_Talk(Object *theObject, CursorMode mode)
{
cMills.Say("No voy a hablarle a un trozo de metal.");
}

function oAbrelatas_Interact(Object *theObject, CursorMode mode)
{
if (player.HasInventory(iLataCerrada)){
  cMills.Say("¿No tenía yo algo sobre lo que usar esto?");
} else {
  cMills.Say("Supongo que puedo guardarme esto por si acaso, aunque todas las latas parecen abiertas.");
}
player.AddInventory(iAbrelatas);
oAbrelatas.Visible = false;
}

function oCubo_Interact(Object *theObject, CursorMode mode)
{
cMills.Say("No voy a tocar eso, ni de broma.");
}

function room_AfterFadeIn()
{
if (gulaPuzzleRadio + gulaPuzzleTV + gulaPuzzleVictima == 3) {
  cMills.Say("Creo que ya he investigado todo lo que podía investigar");
  cMills.Say("Debería hablar con mi compañero para enseñarle lo que he averiguado");
}
}

function hHotspot1_Look(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("¿Quién dice que es un asesinato?");
cWilliam.Say("Nadie...");
cMills.Say("Si esto no fue un ataque al corazón, entonces no sé qué pudo ser.");
}

function hTelevision_Interact(Hotspot *theHotspot, CursorMode mode)
{
player.ChangeRoom(2, 999,  999);
}

function hTelevision_Look(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Sigue encendida, aunque sin señal.");
cMills.Say("Me pregunto si aún se puede resintonizar.");
}

function hTelevision_Talk(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Las televisiones no pueden escucharme, aunque ojalá pudieran mientras grito durante los partidos de fútbol.");
}

function hReloj_Interact(Hotspot *theHotspot, CursorMode mode)
{
  player.ChangeRoom(30, 999, 999);
}

function hReloj_Look(Hotspot *theHotspot, CursorMode mode)
{
if (gulaPuzzleRadio == 1) {
cMills.Say("22 de julio de 1995, sip.");
cWilliam.Say("¿De verdad has tenido que mirarlo otra vez?");
} else {
cMills.Say("Un reloj digital en bastante mal estado.");
cMills.Say("Quizás si lo encendemos de nuevo aprenderemos algo sobre la víctima.");
}
}

function hReloj_Talk(Hotspot *theHotspot, CursorMode mode)
{
  if (gulaPuzzleRadio == 1) {
cMills.Say("No pasa nada por probar, ¿no? Ejem, ACTIVAR.");
cMills.Say("Oh espera, ya está activado.");
} else {
cMills.Say("No creo que esto se active por voz, mucho menos sin batería.");
}
}

function hCubo_Interact(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("No voy a tocar eso, ni de broma.");
}

function hCubo_Look(Hotspot *theHotspot, CursorMode mode)
{
  if (gulaInvestigarCuerpo == 0) {
  cMills.Say("Puaj, dios mío. ¡Ha echado la pota aquí!");
  cMills.Say("¿Podéis llevaros esto?");
  cForense.Say("¿Has dicho vómito? Quizás los sucesos no han ocurrido según pensábamos.");
  cForense.Say("¿Podría venir a mirar el cuerpo más a fondo, detective?");
  gulaInvestigarCuerpo = 1; }
  else {
    cMills.Say("¿De verdad que no queréis llevaroslo? ¿Porfi?");
    cWilliam.Say("Por desgracia, sigue siendo parte de la investigación, así que ahí se queda.");
    }
}

function hCubo_Talk(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Eh... ¿Puede dejar de oler mal, por favor?");
}
