// room script file

function hHerida_Look(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("WOW, si fuese un suicidio la herida no mostraría tanta violencia. Sospechoso…");
}

function hHerida_Interact(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Mejor no tocar esto.");
}

function hHerida_Talk(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Ni que hubiese alguien vivo ahí dentro para conversar. Atento a tu trabajo.");
}

function room_Load()
{
gInv.Visible = false;
gPerchero.Visible = true;
}

function room_Unload()
{
gInv.Visible = true;
gPerchero.Visible = false;
}
