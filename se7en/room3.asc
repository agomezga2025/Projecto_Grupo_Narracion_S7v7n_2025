// room script file

function room_Load()
{
gInv.Visible = false;
gInvAbierto.Visible = false;
gVictima.Visible = true;
}

function room_Unload()
{
gInv.Visible = true;
gVictima.Visible = false;
}

function hCara_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Son ojos llenos de vida, Forense.");
cForense.Say("Ya, ya lo he pillado. Está tiesísimo.");
gulaPistasEncontradasVictima++;
hCara.Enabled = false;
}

function hHeridas_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Son de pistola, Forense.");
cMills.Say("Tenía un arma apoyada contra él mientras comía.");
gulaPistasEncontradasVictima++;
hHeridas.Enabled = false;
}

function hCortes_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Provocados por un cuchillo.");
cMills.Say("La pregunta es: ¿Era de la víctima o de un agresor?");
gulaPistasEncontradasVictima++;
hCortes.Enabled = false;
}

function hAlambres_AnyClick(Hotspot *theHotspot, CursorMode mode)
{
cMills.Say("Manos y pies atados. Estaba siendo forzado a comer.");
gulaPistasEncontradasVictima++;
hAlambres.Enabled = false;
}

function on_call() {
if (gulaPistasEncontradasVictima > 3) {
cForense.Say("Ahora lo veo todo más claro.");
cMills.Say("Más te vale, porque acabo de hacer tu trabajo.");
cForense.Say("De todas formas, ahora sabemos que la víctima estaba comiendo hasta más allá de su límite.");
cForense.Say("Su vida siendo amenazada por el agresor.");
gulaPuzzleVictima = 1;
player.ChangeRoom(1, 160, 198);
} else  {
cMills.Say("No encuentro nada más por ahora. Le echaré un vistazo más tarde.");
  }
  player.ChangeRoom(1, 160, 198);
  }
