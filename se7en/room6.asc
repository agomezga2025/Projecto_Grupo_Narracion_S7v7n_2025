// room script file

function oLlave_AnyClick(Object *theObject, CursorMode mode)
{
cMills.Say("¡Ajá! La llave del cajón… ¿no?");
player.AddInventory(iLlave);
oLlave.Visible = false;
}

function room_Load()
{
gPerchero.Visible = true;
}

function room_Unload()
{
gPerchero.Visible = false;
}
