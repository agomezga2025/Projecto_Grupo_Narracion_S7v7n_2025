function cWilliam_Interact(Character *theCharacter, CursorMode mode)
{
  if (gulaPuzzleRadio + gulaPuzzleTV + gulaPuzzleVictima == 3) {
    
    if (gulaDialogoRepetido == 0){
    cWilliam.Say("¿Tienes algo interesante?");
    cMills.Say("Sí, sobre la víctima.");
    gulaDialogoRepetido = 1;
    dSolucionFinal.Start();
    } 
    else {
    cWilliam.Say("Espero que tengas algo mejor esta vez.");
    dSolucionFinal.Start();
    }
  }
  else {
    cMills.Say("Mejor le dejo a lo suyo. Voy a seguir mirando por aquí.");
    }

  }

