function cPolicia_Talk(Character *theCharacter, CursorMode mode)
{
if (avariciaTieneCuchillo == 0) {dPolicia.Start();}
else {
  cMills.Say("He encontrado esta prueba, parece el arma que se utilizó en el asesinato.");
  cMills.Say("Porque sí, esto no tiene pinta de ser un suicidio y más viendo las letras marcadas por todo su cuerpo.");
  cPolicia.Say("¿Letras marcadas? ¿Qué marcas?");
  cMills.Say("La víctima tiene cortadas, con este cuchillo probablemente, una serie de letras que forman la palabra “Greed”, avaricia en inglés.");
  cPolicia.Say("Interesante cuanto menos. Nunca había visto un caso así.");
  cPolicia.Say("Muchas gracias detective por la prueba. Nos veremos por aquí estos días.");
  player.ChangeRoom(9);
  }
}


