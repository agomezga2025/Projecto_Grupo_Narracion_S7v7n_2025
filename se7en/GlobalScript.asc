cMills.Say("Mi compañero, un detective que aparentemente está a punto de retirarse, pero aún no me ha dicho ni su nombre.");
}

function cForense_Interact(Character *theCharacter, CursorMode mode)
{
  if (gulaInvestigarCuerpo == 0) {
    cMills.Say("¿Alguna novedad?");
    cForense.Say("No da signos de vida. O está muerto, o está disfrutando demasiado esos espaguetis.)");
    }
  else {
    if (gulaPuzzleVictima == 1) {
      cForense.Say("No hay nada más que mirar, esta vez estoy seguro.");
      cMills.Say("Lo que tu digas.");
      } else {
    cForense.Say("Echa un vistazo, detective.");
    player.ChangeRoom(3, 999, 999);
    }
    }
}

