function iLataCerrada_UseInv(InventoryItem *theItem, CursorMode mode)
{
  if (player.ActiveInventory == iAbrelatas) {
  player.AddInventory(iPilas);
  player.LoseInventory(iLataCerrada);
  player.LoseInventory(iAbrelatas);
  cMills.Say("Hombre, esto no son espaguetis");
  cWilliam.Say("¿Qué hay dentro?");
  cMills.Say("Un par de pilas. ¿De dónde serán?");
}
}

function TV2_OnChange(GUIControl *control)
{
int distance2 = 4 - TV2.Value;
if (distance2 < 0) { distance2 = -distance2; }
gulaSintonizacion2 = 10 - distance2;
CallRoomScript(2);
}

function TV1_OnChange(GUIControl *control)
{
int distance1 = 9 - TV1.Value;
if (distance1 < 0) { distance1 = -distance1; }
gulaSintonizacion1 = 10 - distance1;
CallRoomScript(2);
}

function Button1_OnClick(GUIControl *control, MouseButton button)
{
player.ChangeRoom(1, 0, 0);
}

